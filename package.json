{
  "name": "@local/mirror-life",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "镜像人生：把身体健康、家庭关系、本职工作、个人爱好四条线拆成今天能做的动作。体检报告解析成指标；工作任务写一段描述即生成可编辑工作流与一键智能体工作区（含 AGENTS.md，可挂成果模板/知识库/数据库）。",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "life-management",
    "agent-workspace"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
